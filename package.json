{
  "name": "sitecore-ai-cicd-quality-gates",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scanner": "node --test scripts/secret-scan.test.mjs",
    "secrets:check": "node scripts/secret-scan.mjs --staged",
    "secrets:all": "node scripts/secret-scan.mjs --tracked",
    "audit": "pnpm audit --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:scanner && pnpm build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "next": "~16.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.0",
    "eslint-config-next": "~16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "tests/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "src/**/*.css": "prettier --write"
  }
}
